# REACH backend environment configuration
# Copy to .env and fill in real values. Never commit real keys.

# --- LLM provider ---
# Provides the reasoning layer (planning, analysis, synthesis).
# Uses an OpenAI-compatible chat completions API.
# Verified with Groq (see README "Configuration"); any compatible API works.
# Leave empty to use the keyless extractive provider (real, source-grounded
# analysis of the fetched content with no API key).
REACH_LLM_API_KEY=
REACH_LLM_BASE_URL=https://api.openai.com/v1
REACH_LLM_MODEL=gpt-4o-mini

# --- Search provider ---
# Provides web search results.
#   tavily: live Tavily API when REACH_SEARCH_API_KEY is set; falls back to
#           the keyless web aggregator if the key is empty
#   web | keyless | auto: real multi-endpoint search with no API key
# With no search key at all, the keyless web aggregator is used automatically
# (DuckDuckGo, Wikipedia, arXiv, Crossref, GitHub, StackExchange, HN, Reddit).
REACH_SEARCH_API_KEY=
REACH_SEARCH_PROVIDER=tavily
REACH_SEARCH_RESULTS_PER_QUERY=10
REACH_SEARCH_MAX_QUERIES=7

# --- Runtime ---
# "off" (default): real research — keyless web search + extractive analysis
#   when no keys are configured, live providers when keys are set.
# "mock": fully hermetic deterministic pipeline for demo/testing/CI.
REACH_MOCK_MODE=off

# --- Database ---
# Path to the SQLite database file (relative to the backend directory).
REACH_DATABASE_PATH=../data/reach.db

# --- Fetch limits ---
# Bounds for external source fetching (bytes / seconds).
REACH_FETCH_MAX_BYTES=300000
REACH_FETCH_TIMEOUT_SECONDS=15

# --- CORS ---
# Comma separated list of allowed frontend origins.
REACH_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173